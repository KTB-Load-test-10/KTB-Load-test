# Copy this file to .env and adjust values for your environment

ENCRYPTION_KEY=change_me_64_hex_chars____________________________________
ENCRYPTION_SALT=change_me_32_hex_chars________________
JWT_SECRET=change_me_secure_jwt_secret

# Local standalone MongoDB. In a replica-set deployment, override MONGO_URI with:
# mongodb://primary-host:27017,secondary-host:27017/mydb?replicaSet=rs0&readPreference=secondaryPreferred
MONGO_URI=mongodb://localhost:27017/bootcamp-chat
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ktb

PORT=5001
WS_PORT=5002

# File storage. Keep local for development; production backends should all use
# the same private S3 bucket and an IAM role instead of static access keys.
FILE_STORAGE_TYPE=local
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_PREFIX=

OPENAI_API_KEY=sk-...
